# App identity
APP_NAME="board"
APP_USER="web"
APP_GROUP="web"

# Git source. Override REPO_URL when running the init script.
REPO_URL=""
REPO_BRANCH="main"

# Current project keeps the first app at /var/www/html.
APP_ROOT="/var/www/html"
BACKEND_DIR="backend"
REQUIREMENTS_FILE="backend/requirements.txt"

# Shared Python environment for this web host.
PYTHON_BIN="python3.12"
VENV_DIR="/var/www/.venv"

# Gunicorn
GUNICORN_APP="wsgi:app"
GUNICORN_WORKERS="3"
GUNICORN_BIND="127.0.0.1:8000"

# systemd and nginx
SYSTEMD_SOURCE="systemd/board.service"
SYSTEMD_TARGET="/etc/systemd/system/board.service"
NGINX_SOURCE="nginx/sites-available/mini-board.conf"
NGINX_AVAILABLE="/etc/nginx/sites-available/board.conf"
NGINX_ENABLED="/etc/nginx/sites-enabled/board.conf"
NGINX_LOCATION_SOURCE="nginx/app-locations/board.conf"
NGINX_LOCATION_TARGET="/etc/nginx/app-locations/board.conf"
