# DB host identity
DB_SERVER_IP="10.0.2.11"
WEB_SERVER_IP="10.0.2.10"

# Git source. Override REPO_URL when running the init script.
REPO_URL=""
REPO_BRANCH="master"
REPO_ROOT="/var/www/html"

# MariaDB
MARIADB_BIND_ADDRESS="10.0.2.11"
MARIADB_CONFIG_FILE="/etc/mysql/mariadb.conf.d/60-board-bind.cnf"

# SQL seed
INIT_SQL_SOURCE="database/init.sql"
