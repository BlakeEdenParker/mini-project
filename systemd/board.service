[Unit]
Description=Mini Board Gunicorn
After=network.target

[Service]
User=web
Group=web
WorkingDirectory=/var/www/html/service
EnvironmentFile=-/var/www/html/service/.env
ExecStart=/var/www/.venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
